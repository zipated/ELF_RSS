# 配置 NoneBot 监听的 IP/主机名
HOST=0.0.0.0
# 配置 NoneBot 监听的端口
PORT=8080
# 开启 debug 模式 **请勿在生产环境开启**
DEBUG=false
# 配置 NoneBot 超级用户：管理员qq，支持多管理员，逗号分隔 注意，启动消息只发送给第一个管理员
SUPERUSERS=["123123123"]
# 配置机器人的昵称
NICKNAME=["elf","ELF"]
# 配置命令起始字符
COMMAND_START=["","/"]
# 配置命令分割字符
COMMAND_SEP=["."]

# 代理地址
#RSS_PROXY="127.0.0.1:7890"
# rsshub订阅地址
RSSHUB="https://rsshub.app"
# 备用 rsshub 地址 示例： ["https://rsshub.app","https://rsshub.app"] 务必使用双引号！！！
RSSHUB_BACKUP=[]
# 去重数据库的记录清理限定天数
DB_CACHE_EXPIRE=30
# 缓存rss条数
LIMIT=200
# 正文长度限制，防止消息太长刷屏，以及消息过长发送失败的情况
MAX_LENGTH=1024
# 是否启用启动时的提示消息推送
ENABLE_BOOT_MESSAGE=true

# 图片压缩
# 非 GIF 图片压缩后的最大长宽值，单位 px
ZIP_SIZE=2048
# GIF 图片压缩临界值，单位 KB
GIF_ZIP_SIZE=6144
# 保存图片的文件名,可使用 {subs}:订阅名 {name}:文件名 {ext}:文件后缀(可省略)
IMG_FORMAT="{subs}/{name}{ext}"
# 图片的下载路径,默认为./data/image 可以为相对路径(./test)或绝对路径(/home)
IMG_DOWN_PATH=""

# 是否显示转发的内容(主要是微博)，默认打开，如果关闭还有转发的信息的话，可以自行添加进屏蔽词(但是这整条消息就会没)
BLOCKQUOTE=true
# 屏蔽词填写 支持正则，如 ["互动抽奖","微博抽奖平台"] 务必使用双引号！！！
BLACK_WORD=[]

# 使用百度翻译API 可选，填的话两个都要填
# 百度翻译接口appid和secretKey，前往http://api.fanyi.baidu.com/获取
# 一般来说申请标准版免费就够了，想要好一点可以认证上高级版，有月限额，rss用也足够了
BAIDU_ID=""
BAIDU_KEY=""
# DEEPL 翻译API 可选
DEEPL_TRANSLATOR_API_KEY=""
# AI 翻译配置（基于 any-llm-sdk）
#   provider 为服务商类型，可选，常见取值：
#     openai_compatible  任意 OpenAI 兼容端点（中转站、自部署 vLLM/SGLang、厂商兼容接口），必须填 base_url
#     openai / deepseek / moonshot / zai / minimax / dashscope / openrouter  各官方厂商的 OpenAI 兼容接口
#     anthropic / gemini / vertexai   非 OpenAI 协议的官方厂商
#     ollama / lmstudio / llamacpp / vllm  本地或自部署服务（key 可留空）
#   不填 provider 时：填了 base_url 按 openai_compatible 处理，否则按 openai 处理，因此建议显式配置
#   model 直接填写服务商要求的模型名，不需要加前缀，如 deepseek-chat
#   prompt 为自定义 system prompt，{lang} 为原语言变量
AI_API_PROVIDER=""
AI_API_KEY=""
AI_API_BASE_URL=""
AI_API_MODEL=""
AI_API_PROMPT=""
# AI翻译额外参数，JSON格式，原样写入请求体，不做参数名白名单校验
# 同一模型在不同服务商要求的参数往往不同，按节点分别配置即可，例如：
#   {"thinking": {"type": "enabled"}}
#   {"enable_thinking": true}
AI_API_EXTRA_PARAMS={}
# 是否对此节点的 AI 请求使用代理（需先配置 RSS_PROXY）
# 代理绑定在该节点的客户端上，不同节点独立控制，互不影响
AI_API_USE_PROXY=false
# 是否允许此节点用于资料库生成（默认 true，设为 false 则跳过）
# 关闭此项可防止功能不足的模型生成错误资料库
AI_API_KB_ENABLED=true
# -----------------------------------------------------------------
# AI翻译多节点配置（编号节点按编号顺序追加在默认节点之后，编号可以跳号）
# 配置了 PROVIDER / KEY / BASE_URL / MODEL 任意一项才会被视为一个节点，全空则跳过该编号
# 编号节点未配置 base_url / model / prompt 时，沿用默认节点的对应取值
# 自部署节点可以只填 provider 和 base_url，AI_API_KEY 留空
# -----------------------------------------------------------------
# AI_API_PROVIDER1="openai_compatible"
# AI_API_KEY1=""
# AI_API_BASE_URL1=""
# AI_API_MODEL1=""
# AI_API_PROMPT1=""
# AI_API_EXTRA_PARAMS1={}
# AI_API_USE_PROXY1=false
# AI_API_KB_ENABLED1=true
# AI_API_PROVIDER2="deepseek"
# AI_API_KEY2=""
# AI_API_BASE_URL2=""
# AI_API_MODEL2=""
# AI_API_PROMPT2=""
# AI_API_EXTRA_PARAMS2={}
# AI_API_USE_PROXY2=false
# AI_API_KB_ENABLED2=true
# -----------------------------------------------------------------
# 资料库搜索 API（火山引擎联网搜索）
# 必须配置 API Key 才能启用订阅的 kb 功能，未配置则所有 kb 功能不可用
# 前往 https://console.volcengine.com/search-infinity/api-key 创建
# 文档：https://www.volcengine.com/docs/87772/2272953
# -----------------------------------------------------------------
KB_SEARCH_API_KEY=""
# 搜索时指定站点范围，多个域名用 | 分隔，如 "aliyun.com|mp.qq.com"（选填）
KB_SEARCH_SITES=""
# 搜索时屏蔽站点，多个域名用 | 分隔（选填）
KB_SEARCH_BLOCK_HOSTS=""
# -----------------------------------------------------------------
# 语言检测接口，前往 https://detectlanguage.com/documentation 注册获取 api_key
# 配合 DeepL 和 AI 翻译使用
SINGLE_DETECTION_API_KEY=""

# qbittorrent 相关设置(文件下载位置等更多设置请在qbittorrent软件中设置)
# qbittorrent 用户名
QB_USERNAME=""
# qbittorrent 密码
QB_PASSWORD=""
# qbittorrent 客户端默认是关闭状态，请打开并设置端口号为 8081，同时勾选 “对本地主机上的客户端跳过身份验证”
#QB_WEB_URL="http://127.0.0.1:8081"
# qb的文件下载地址，这个地址必须是 go-cqhttp能访问到的
QB_DOWN_PATH=""
# 下载进度消息提示群组 示例 [12345678] 注意：最好是将该群设置为免打扰
DOWN_STATUS_MSG_GROUP=[]
# 下载进度检查及提示间隔时间，单位秒，不建议小于 10
DOWN_STATUS_MSG_DATE=10

# pikpak 相关设置
# pikpak 用户名
PIKPAK_USERNAME=""
# pikpak 密码
PIKPAK_PASSWORD=""
# pikpak 离线保存的目录, 默认是根目录，示例: ELF_RSS/Downloads ,目录不存在会自动创建, 不能/结尾
PIKPAK_DOWNLOAD_PATH=""

# Telegram 相关设置
# Telegram 管理员 ID 列表，用于接收离线通知和管理机器人
TELEGRAM_ADMIN_IDS=[]
# Telegram 机器人的 token
TELEGRAM_BOT_TOKEN=""

# MYELF博客地址 https://myelf.club
# 出现问题请在 GitHub 上提 issues
# 项目地址 https://github.com/Quan666/ELF_RSS